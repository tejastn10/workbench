{
	"name": "workbench-site",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"sync-assets": "cp ../logo.svg public/logo.svg",
		"predev": "npm run sync-assets",
		"prebuild": "npm run sync-assets",
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome check --write --linter-enabled=false .",
		"format:check": "biome check --linter-enabled=false .",
		"check": "biome check .",
		"check:fix": "biome check --write ."
	},
	"engines": {
		"node": ">=22"
	},
	"packageManager": "npm@10.9.0",
	"dependencies": {
		"geist": "^1.5.1",
		"gray-matter": "^4.0.3",
		"next": "^15.5.0",
		"next-themes": "^0.4.6",
		"react": "^19.1.0",
		"react-dom": "^19.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@tailwindcss/postcss": "^4.1.0",
		"@types/node": "^22.0.0",
		"@types/react": "^19.1.0",
		"@types/react-dom": "^19.1.0",
		"tailwindcss": "^4.1.0",
		"typescript": "^5.7.0"
	}
