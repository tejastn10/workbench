{
	"name": "workbench-site",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"sync-assets": "mkdir -p public && cp ../logo.svg public/logo.svg",
		"figures": "node figures/build-all.mjs",
		"predev": "npm run sync-assets && npm run figures",
		"prebuild": "npm run sync-assets && npm run figures",
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write .",
		"format": "biome check --write --linter-enabled=false .",
		"format:check": "biome check --linter-enabled=false .",
		"check": "biome check .",
		"check:fix": "biome check --write ."
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "npm@10.9.0",
	"dependencies": {
		"geist": "^1.9.2",
		"gray-matter": "^4.0.3",
		"next": "^16.4.6",
		"next-themes": "^0.4.6",
		"react": "^19.3.1",
		"react-dom": "^19.3.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@tailwindcss/postcss": "^4.3.5",
		"@types/node": "^26.6.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"tailwindcss": "^4.3.5",
		"typescript": "^7.0.2"
	}
}
